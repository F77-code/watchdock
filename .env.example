# Сокет демона видит только docker-proxy. Watchdock ходит в него по TCP.
DOCKER_HOST=tcp://docker-proxy:2375
# Пусто — Watchdock читает лейбл своего контейнера и следит за этим compose-проектом.
# Укажите имя, только если смотреть нужно другой проект на том же демоне.
COMPOSE_PROJECT_NAME=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-nano
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LOG_LEVEL=INFO
BUFFER_SIZE_LINES=200
DEBOUNCE_WINDOW_SEC=5
COOLDOWN_PERIOD_SEC=300
MIN_SEVERITY=LOW
IGNORED_CONTAINERS=
HOST_DISK_PATH=/
HEARTBEAT_SEC=300
HEARTBEAT_PATH=/tmp/watchdock-heartbeat
